# Скопируйте в .env (он в .gitignore) — docker compose подхватит его сам.
# На Railway те же переменные задаются в сервисе приложения → Variables.

# Первый администратор кабинета /operator. Создаётся один раз — когда в базе ещё нет сотрудников;
# дальше сотрудники и пароли управляются в кабинете («Сотрудники», «Профиль»).
# Если пароль не задан (или короче 8 символов) — сервер придумает его и напишет в лог.
ADMIN_LOGIN=admin
ADMIN_NAME="Анна К."
ADMIN_PASSWORD=придумайте-длинный-пароль

# Пароль Postgres в docker compose (на Railway не нужен — там DATABASE_URL от сервиса Postgres)
POSTGRES_PASSWORD=app

# true — показать в кабинете кнопку «Сбросить демо-данные»
ALLOW_RESET=false
